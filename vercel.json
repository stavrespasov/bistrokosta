{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["fra1"],
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/admin", "destination": "/staff.html" },
    { "source": "/kitchen", "destination": "/staff.html" },
    { "source": "/rezervacije", "destination": "/reservations.html" },
    { "source": "/api/:route*", "destination": "/api/handler?route=:route*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
    ]}
  ]
}
